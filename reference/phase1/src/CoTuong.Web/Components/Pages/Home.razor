@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CoTuong.Core.Dtos
@using CoTuong.Web.Components.Pages.Account
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState

<PageTitle>Trang chính | Cờ Tướng</PageTitle>
<div class="dashboard-header">
    <div><p class="eyebrow">CỜ TƯỚNG TRỰC TUYẾN</p><h1>Xin chào, @_displayName</h1><p>Tạo phòng mới hoặc tham gia cùng bạn bè.</p></div>
    <button class="btn btn-outline-secondary" @onclick="LogoutAsync">Đăng xuất</button>
</div>

@if (!string.IsNullOrEmpty(_error)) { <p class="error-message" role="alert">@_error</p> }

<div class="dashboard-grid">
    <section class="panel">
        <h2>Tạo Room</h2>
        <EditForm Model="_create" OnValidSubmit="CreateRoomAsync">
            <DataAnnotationsValidator />
            <label for="room-name">Tên Room</label>
            <InputText id="room-name" class="form-control" @bind-Value="_create.TenPhong" />
            <ValidationMessage For="() => _create.TenPhong" />
            <label for="visibility">Chế độ</label>
            <InputSelect id="visibility" class="form-select" @bind-Value="_create.CheDoHienThi">
                <option value="Public">Công khai</option><option value="Private">Riêng tư</option>
            </InputSelect>
            <button class="btn btn-primary mt-3" disabled="@_busy">Tạo Room</button>
        </EditForm>
    </section>

    <section class="panel">
        <h2>Tham gia bằng mã</h2>
        <EditForm Model="_join" OnValidSubmit="JoinByCodeAsync">
            <DataAnnotationsValidator />
            <label for="room-code">Mã Room gồm 6 chữ số</label>
            <InputText id="room-code" class="form-control" @bind-Value="_join.MaPhong" maxlength="6" inputmode="numeric" />
            <ValidationMessage For="() => _join.MaPhong" />
            <button class="btn btn-primary mt-3" disabled="@_busy">Tham gia</button>
        </EditForm>
    </section>

    <section class="panel panel-wide">
        <div class="section-heading"><h2>Room công khai</h2><button class="btn btn-sm btn-outline-primary" @onclick="LoadRoomsAsync">Làm mới</button></div>
        @if (_rooms.Count == 0) { <p>Hiện chưa có Room công khai đang hoạt động.</p> }
        else
        {
            <div class="room-list">
                @foreach (var room in _rooms)
                {
                    var roomId = Long(room, "maPhong");
                    <article class="room-list-item">
                        <div><strong>@Text(room, "tenPhong")</strong><small>Chủ phòng: @Text(room, "tenHienThiChuPhong") · @Status(Text(room, "trangThai"))</small></div>
                        <span>@Text(room, "soKhanGia")/@Text(room, "soKhanGiaToiDa") khán giả</span>
                        <button class="btn btn-sm btn-primary" @onclick="() => JoinRoomAsync(roomId)">Vào Room</button>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel panel-wide shortcuts">
        <h2>Kết nối bạn bè</h2>
        <p>Tìm người chơi, quản lý lời mời và xem trạng thái online.</p>
        <a class="btn btn-outline-primary" href="/friends">Mở danh sách bạn bè</a>
    </section>
</div>

@code {
    private readonly CreateRoomForm _create = new();
    private readonly JoinRoomForm _join = new();
    private List<System.Text.Json.JsonElement> _rooms = [];
    private string _displayName = "người chơi";
    private string? _error;
    private bool _busy;
    private string _createKey = Guid.NewGuid().ToString("N");

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _displayName = state.User.FindFirst("display_name")?.Value ?? state.User.Identity?.Name ?? _displayName;
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.get", "/api/rooms/public");
        _rooms = result.Ok && result.Data.ValueKind == System.Text.Json.JsonValueKind.Array
            ? result.Data.EnumerateArray().Select(x => x.Clone()).ToList() : [];
    }

    private async Task CreateRoomAsync()
    {
        _busy = true; _error = null;
        try
        {
            var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/rooms", _create, _createKey);
            if (!result.Ok) { _error = Error(result); return; }
            _createKey = Guid.NewGuid().ToString("N");
            Navigation.NavigateTo($"/room/{Long(result.Data, "maPhong")}");
        }
        catch (JSException) { _error = "Không thể kết nối máy chủ."; }
        finally { _busy = false; }
    }

    private async Task JoinByCodeAsync()
    {
        _busy = true; _error = null;
        try
        {
            var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/rooms/join/code", _join);
            if (!result.Ok) { _error = Error(result); return; }
            Navigation.NavigateTo($"/room/{Long(result.Data, "maPhong")}");
        }
        catch (JSException) { _error = "Không thể kết nối máy chủ."; }
        finally { _busy = false; }
    }

    private async Task JoinRoomAsync(long id)
    {
        var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", $"/api/rooms/join/public/{id}", new { });
        if (!result.Ok) { _error = Error(result); return; }
        Navigation.NavigateTo($"/room/{id}");
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/auth/logout", new { });
        Navigation.NavigateTo("/account/login", forceLoad: true);
    }

    private static long Long(System.Text.Json.JsonElement value, string name) => value.TryGetProperty(name, out var item) && item.TryGetInt64(out var number) ? number : 0;
    private static string Text(System.Text.Json.JsonElement value, string name) => value.TryGetProperty(name, out var item) ? item.ToString() : "";
    private static string Error(BrowserApiResult result) => result.Data.TryGetProperty("message", out var value) ? value.GetString() ?? "Thao tác thất bại." : "Thao tác thất bại.";
    private static string Status(string value) => value switch { "WaitingOpponent" => "Đang chờ Đối thủ", "Full" => "Đã đủ người chơi", _ => value };
}
