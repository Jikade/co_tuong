@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.Json
@using CoTuong.Web.Components.Pages.Account
@inject IJSRuntime JS

<PageTitle>Thông báo | Cờ Tướng</PageTitle>
<h1>Thông báo</h1>
@if (!string.IsNullOrEmpty(_message)) { <p class="success-message" role="status">@_message</p> }
@if (!string.IsNullOrEmpty(_error)) { <p class="error-message" role="alert">@_error</p> }
<section class="panel">
    @if (_items.Count == 0) { <p>Chưa có thông báo.</p> }
    @foreach (var item in _items)
    {
        var id = Long(item, "ma");
        var type = Text(item, "loai");
        <article class="notification-row @(Bool(item, "daDoc") ? "read" : "unread")">
            <div><strong>@Message(item)</strong><small>@Text(item, "ngayTao")</small></div>
            @if (type == "RoomInvitationReceived" && Long(item, "maLoiMoiVaoPhong") is var inviteId && inviteId > 0)
            {
                <button class="btn btn-sm btn-primary" @onclick="() => RespondAsync(inviteId, true, id)">Tham gia</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => RespondAsync(inviteId, false, id)">Từ chối</button>
            }
            else if (!Bool(item, "daDoc"))
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkReadAsync(id)">Đánh dấu đã đọc</button>
            }
        </article>
    }
</section>

@code {
    private List<JsonElement> _items = [];
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.get", "/api/notifications");
        if (result.Ok && result.Data.ValueKind == JsonValueKind.Array) _items = result.Data.EnumerateArray().Select(x => x.Clone()).ToList();
        else _error = Error(result);
    }

    private async Task RespondAsync(long inviteId, bool accept, long notificationId)
    {
        var response = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post",
            $"/api/rooms/invites/{inviteId}/{(accept ? "accept" : "decline")}", new { });
        if (!response.Ok) { _error = Error(response); return; }
        await MarkReadAsync(notificationId);
        _message = accept ? "Đã tham gia Room." : "Đã từ chối lời mời.";
        if (accept) NavigationManager.NavigateTo($"/room/{Long(_items.FirstOrDefault(x => Long(x, "ma") == notificationId), "maPhong")}");
        await ReloadAsync();
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private async Task MarkReadAsync(long id)
    {
        var result = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", $"/api/notifications/{id}/read", new { });
        if (!result.Ok) _error = Error(result); else await ReloadAsync();
    }

    private static string Message(JsonElement item)
    {
        var actor = Text(item, "tenNguoiThucHien");
        return Text(item, "loai") switch
        {
            "FriendRequestReceived" => $"{actor} đã gửi lời mời kết bạn.",
            "FriendRequestAccepted" => $"{actor} đã chấp nhận lời mời kết bạn.",
            "FriendRequestRejected" => $"{actor} đã từ chối lời mời kết bạn.",
            "RoomInvitationReceived" => $"{actor} mời bạn vào Room.",
            "RoomInvitationDeclined" => $"{actor} đã từ chối lời mời vào Room.",
            "RoomInvitationCancelled" => $"{actor} đã hủy lời mời vào Room.",
            "RoomInvitationExpired" => "Lời mời vào Room đã hết hạn.",
            _ => "Bạn có thông báo mới."
        };
    }

    private static long Long(JsonElement item, string name) => item.ValueKind == JsonValueKind.Object && item.TryGetProperty(name, out var x) && x.TryGetInt64(out var value) ? value : 0;
    private static string Text(JsonElement item, string name) => item.ValueKind == JsonValueKind.Object && item.TryGetProperty(name, out var x) && x.ValueKind != JsonValueKind.Null ? x.ToString() : "";
    private static bool Bool(JsonElement item, string name) => item.ValueKind == JsonValueKind.Object && item.TryGetProperty(name, out var x) && x.ValueKind == JsonValueKind.True;
    private static string Error(BrowserApiResult result) => result.Data.ValueKind == JsonValueKind.Object && result.Data.TryGetProperty("message", out var x) ? x.GetString() ?? "Thao tác thất bại." : "Không thể tải thông báo.";
}
