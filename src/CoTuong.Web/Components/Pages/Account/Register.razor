@page "/account/register"
@using CoTuong.Web.Components.Pages.Account
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Đăng ký | Cờ Tướng</PageTitle>
<section class="account-card">
    <h1>Tạo tài khoản</h1>
    @if (!string.IsNullOrEmpty(_error)) { <p class="error-message" role="alert">@_error</p> }
    <EditForm Model="_form" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <label for="username">Tên đăng nhập</label>
        <InputText id="username" class="form-control" @bind-Value="_form.TenDangNhap" autocomplete="username" />
        <ValidationMessage For="() => _form.TenDangNhap" />
        <label for="display-name">Tên hiển thị</label>
        <InputText id="display-name" class="form-control" @bind-Value="_form.TenHienThi" />
        <ValidationMessage For="() => _form.TenHienThi" />
        <label for="email">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="_form.Email" autocomplete="email" />
        <ValidationMessage For="() => _form.Email" />
        <label for="password">Mật khẩu</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="_form.MatKhau" autocomplete="new-password" />
        <ValidationMessage For="() => _form.MatKhau" />
        <label for="confirm-password">Xác nhận mật khẩu</label>
        <InputText id="confirm-password" type="password" class="form-control" @bind-Value="_form.XacNhanMatKhau" autocomplete="new-password" />
        <ValidationMessage For="() => _form.XacNhanMatKhau" />
        <button class="btn btn-primary mt-3" disabled="@_busy">@(_busy ? "Đang tạo tài khoản…" : "Đăng ký")</button>
    </EditForm>
    <p class="account-links"><a href="/account/login">Đã có tài khoản? Đăng nhập</a></p>
</section>

@code {
    private readonly RegisterForm _form = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true; _error = null;
        try
        {
            var response = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/auth/register", _form);
            if (!response.Ok)
            {
                _error = response.Data.TryGetProperty("message", out var message) ? message.GetString() : "Không thể tạo tài khoản.";
                return;
            }
            Navigation.NavigateTo("/account/login?registered=true", forceLoad: true);
        }
        catch (JSException) { _error = "Không thể kết nối máy chủ. Vui lòng thử lại."; }
        finally { _busy = false; }
    }
}
