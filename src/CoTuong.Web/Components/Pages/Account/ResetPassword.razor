@page "/reset-password"
@using CoTuong.Web.Components.Pages.Account
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Đặt lại mật khẩu | Cờ Tướng</PageTitle>
<section class="account-card">
    <h1>Đặt lại mật khẩu</h1>
    @if (!string.IsNullOrEmpty(_error)) { <p class="error-message" role="alert">@_error</p> }
    <EditForm Model="_form" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <label for="password">Mật khẩu mới</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="_form.MatKhauMoi" autocomplete="new-password" />
        <ValidationMessage For="() => _form.MatKhauMoi" />
        <label for="confirm-password">Xác nhận mật khẩu mới</label>
        <InputText id="confirm-password" type="password" class="form-control" @bind-Value="_form.XacNhanMatKhauMoi" autocomplete="new-password" />
        <ValidationMessage For="() => _form.XacNhanMatKhauMoi" />
        <button class="btn btn-primary mt-3" disabled="@_busy">Lưu mật khẩu mới</button>
    </EditForm>
</section>

@code {
    private readonly ResetPasswordForm _form = new();
    private string? _error;
    private bool _busy;
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    protected override void OnParametersSet() => _form.Token = Token ?? string.Empty;

    private async Task SubmitAsync()
    {
        _busy = true; _error = null;
        try
        {
            var response = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/auth/reset-password", _form);
            if (response.Ok) Navigation.NavigateTo("/account/login?reset=true", forceLoad: true);
            else _error = response.Data.TryGetProperty("message", out var message) ? message.GetString() : "Liên kết đặt lại mật khẩu không còn hiệu lực.";
        }
        catch (JSException) { _error = "Không thể kết nối máy chủ. Vui lòng thử lại."; }
        finally { _busy = false; }
    }
}
