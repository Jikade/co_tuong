@page "/account/forgot-password"
@using CoTuong.Web.Components.Pages.Account
@inject IJSRuntime JS

<PageTitle>Quên mật khẩu | Cờ Tướng</PageTitle>
<section class="account-card">
    <h1>Quên mật khẩu</h1>
    <p>Nhập email đã đăng ký. Nếu email tồn tại, hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu.</p>
    @if (!string.IsNullOrEmpty(_message)) { <p class="success-message" role="status">@_message</p> }
    @if (!string.IsNullOrEmpty(_error)) { <p class="error-message" role="alert">@_error</p> }
    <EditForm Model="_form" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <label for="email">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="_form.Email" autocomplete="email" />
        <ValidationMessage For="() => _form.Email" />
        <button class="btn btn-primary mt-3" disabled="@_busy">Gửi hướng dẫn</button>
    </EditForm>
    <p class="account-links"><a href="/account/login">Quay lại đăng nhập</a></p>
</section>

@code {
    private readonly EmailForm _form = new();
    private string? _message;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true; _error = null; _message = null;
        try
        {
            var response = await JS.InvokeAsync<BrowserApiResult>("coTuongApi.post", "/api/auth/forgot-password", _form);
            if (response.Ok) _message = response.Data.GetProperty("message").GetString();
            else _error = response.Data.TryGetProperty("message", out var message) ? message.GetString() : "Email không đúng định dạng.";
        }
        catch (JSException) { _error = "Không thể kết nối máy chủ. Vui lòng thử lại."; }
        finally { _busy = false; }
    }
}
