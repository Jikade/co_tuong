# file (durable local default) | memory (tests only) | sqlserver
DB_MODE=file
DATA_FILE=data/integration.json
PORT=3001
APP_HOST=0.0.0.0
STATIC_DIR=dist

DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_DATABASE=CoTuongIntegration
# sqlcmd = Windows integrated auth, requires sqlcmd/ODBC, no password.
# mssql = portable SQL authentication, requires TCP/IP enabled.
DB_DRIVER=sqlcmd
DB_USER=
DB_PASSWORD=

# Local SQL Server often needs this:
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000
# Pool settings apply to DB_DRIVER=mssql; numbers and booleans are validated.

# Base schema must be installed explicitly with npm run db:setup.
# true = create only the additive integration tables if missing
DB_AUTO_MIGRATE=false

# file = private development outbox; smtp = Node SMTP transport.
MAIL_PROVIDER=file
MAIL_OUTBOX=data/outbox
APP_PUBLIC_URL=http://localhost:5173
# SMTP example: use your provider's credentials in .env, never Git.
# STARTTLS: SMTP_SECURE=false, SMTP_REQUIRE_TLS=true, usually port 587.
# Implicit TLS: SMTP_SECURE=true, usually port 465. Certificates are verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_MS=500
SMTP_TIMEOUT_MS=10000
# Optional private CA certificate file (never disables certificate validation):
# SMTP_TLS_CA_FILE=certs/smtp-ca.pem

# Optional HTTPS: set both files together, relative to the project root or absolute.
# TLS_CERT_FILE=certs/lan.pem
# TLS_KEY_FILE=certs/lan-key.pem
