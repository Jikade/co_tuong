# memory | sqlserver
DB_MODE=memory

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CHANGE_ME_DATABASE
DB_USER=sa
DB_PASSWORD=CHANGE_ME

# Local SQL Server often needs this:
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000

# true = backend creates the two phase4 bridge tables if missing
# false = run database/phase4_runtime_bridge.sql yourself
DB_AUTO_MIGRATE=false
