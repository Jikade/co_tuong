{
  "name": "xiangqi",
  "private": true,
  "version": "1.0.0",
  "description": "Chơi cờ tướng trực tuyến với đồng bộ WebSocket",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "node --env-file-if-exists=.env scripts/check-architecture.js --server",
    "build:client": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "check:architecture": "node scripts/check-architecture.js",
    "preview": "node --env-file-if-exists=.env server.js",
    "server": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --test \"test/*.test.js\"",
    "test:sql": "node --env-file-if-exists=.env --test test/sql-integration.test.js",
    "test:e2e": "playwright test",
    "test:qa:e2e": "playwright test --config playwright.qa.config.js",
    "test:qa:sql": "node --env-file-if-exists=.env --test --test-concurrency=1 test/sql-integration.test.js test/qa-sql.test.js",
    "qa:report": "node scripts/qa/report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "mssql": "^12.7.11",
    "ws": "^8.22.0"
  }
}
