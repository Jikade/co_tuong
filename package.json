{
  "name": "xiangqi",
  "private": true,
  "version": "1.0.0",
  "description": "Chơi cờ tướng trực tuyến với đồng bộ WebSocket",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/index.js -k -n server,vite \"node server.js\" \"vite --host 0.0.0.0\"",
    "build": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --test \"test/*.test.js\"",
    "test:sql": "node --env-file-if-exists=.env --test test/sql-integration.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "mssql": "^12.7.11",
    "ws": "^8.22.0"
  }
}
